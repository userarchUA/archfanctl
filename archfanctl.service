[Unit]
Description=ArchFanCtl fan control daemon
After=multi-user.target nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/bin/archfanctld
ExecStopPost=/usr/bin/archfanctld --restore
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
