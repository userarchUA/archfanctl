#!/usr/bin/python
import sys, os, json, subprocess, uuid, time
sys.path.insert(0, "/usr/lib/archfanctl")
import core
from PyQt6.QtCore import Qt, QTimer, QPointF, QRectF, pyqtSignal
from PyQt6.QtGui import QPainter, QPen, QBrush, QColor, QPalette, QPolygonF
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, QHBoxLayout, QVBoxLayout, QFormLayout,
                             QListWidget, QListWidgetItem, QPushButton, QLineEdit, QComboBox,
                             QDoubleSpinBox, QLabel, QMessageBox, QGroupBox)

DEFAULT_CURVE = [[30, 25], [45, 35], [60, 55], [75, 80], [85, 100]]


class Curve(QWidget):
    changed = pyqtSignal()
    TMIN, TMAX = 20, 100

    def __init__(self):
        super().__init__()
        self.pts, self.drag, self.live = [list(p) for p in DEFAULT_CURVE], None, None
        self.setMinimumSize(440, 300)

    def set_points(self, pts):
        self.pts = [[float(a), float(b)] for a, b in pts]
        self.update()

    def plot(self):
        return QRectF(self.rect()).adjusted(46, 12, -14, -32)

    def px(self, t, p):
        r = self.plot()
        return QPointF(r.left() + (t - self.TMIN) / (self.TMAX - self.TMIN) * r.width(), r.bottom() - p / 100 * r.height())

    def unpx(self, pt):
        r = self.plot()
        t = self.TMIN + (pt.x() - r.left()) / r.width() * (self.TMAX - self.TMIN)
        p = (r.bottom() - pt.y()) / r.height() * 100
        return max(self.TMIN, min(self.TMAX, t)), max(0, min(100, p))

    def hit(self, pos):
        for i, (t, p) in enumerate(self.pts):
            q = self.px(t, p)
            if (q.x() - pos.x()) ** 2 + (q.y() - pos.y()) ** 2 <= 100:
                return i

    def paintEvent(self, _):
        qp = QPainter(self)
        qp.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = self.palette()
        fg, grid, acc = pal.color(QPalette.ColorRole.WindowText), pal.color(QPalette.ColorRole.Mid), pal.color(QPalette.ColorRole.Highlight)
        r = self.plot()
        for t in range(self.TMIN, self.TMAX + 1, 10):
            qp.setPen(QPen(grid, 1)); qp.drawLine(self.px(t, 0), self.px(t, 100))
            qp.setPen(fg); qp.drawText(QPointF(self.px(t, 0).x() - 12, r.bottom() + 18), f"{t}°")
        for p in range(0, 101, 20):
            qp.setPen(QPen(grid, 1)); qp.drawLine(self.px(self.TMIN, p), self.px(self.TMAX, p))
            qp.setPen(fg); qp.drawText(QPointF(8, self.px(self.TMIN, p).y() + 4), f"{p}%")
        pts = sorted(self.pts)
        poly = QPolygonF([self.px(self.TMIN, pts[0][1])] + [self.px(t, p) for t, p in pts] + [self.px(self.TMAX, pts[-1][1])])
        qp.setPen(QPen(acc, 2.5)); qp.drawPolyline(poly)
        qp.setBrush(QBrush(acc)); qp.setPen(QPen(fg, 1))
        for t, p in pts:
            qp.drawEllipse(self.px(t, p), 6, 6)
        if self.live is not None:
            c = QColor(220, 60, 60)
            qp.setPen(QPen(c, 1.5, Qt.PenStyle.DashLine)); qp.drawLine(self.px(self.live, 0), self.px(self.live, 100))
            qp.setPen(c); qp.drawText(QPointF(self.px(self.live, 100).x() + 4, r.top() + 12), f"{self.live:.0f}°C")

    def mousePressEvent(self, e):
        i = self.hit(e.position())
        if e.button() == Qt.MouseButton.LeftButton:
            self.drag = i
        elif e.button() == Qt.MouseButton.RightButton and i is not None and len(self.pts) > 2:
            self.pts.sort(); del self.pts[i]; self.update(); self.changed.emit()

    def mouseMoveEvent(self, e):
        i = self.drag
        if i is None:
            return
        self.pts.sort()
        t, p = self.unpx(e.position())
        lo = self.pts[i - 1][0] + 1 if i > 0 else self.TMIN
        hi = self.pts[i + 1][0] - 1 if i < len(self.pts) - 1 else self.TMAX
        self.pts[i] = [round(max(lo, min(hi, t))), round(p)]
        self.update(); self.changed.emit()

    def mouseReleaseEvent(self, _):
        self.drag = None

    def mouseDoubleClickEvent(self, e):
        if self.hit(e.position()) is None and len(self.pts) < 16:
            t, p = self.unpx(e.position()); t = round(t)
            if all(abs(q[0] - t) >= 1 for q in self.pts):
                self.pts.append([t, round(p)]); self.pts.sort(); self.update(); self.changed.emit()


def spin(lo, hi, step, suffix, dec=0):
    s = QDoubleSpinBox(); s.setRange(lo, hi); s.setSingleStep(step); s.setSuffix(suffix); s.setDecimals(dec)
    return s


class Win(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("ArchFanCtl — fan control")
        self.resize(1000, 660)
        self.dev, self.cur, self.loading = core.discover(), None, True
        try:
            with open(core.CONFIG) as f: self.cfg = json.load(f)
        except Exception:
            self.cfg = {"version": 1, "interval": 1.0, "controls": []}

        self.list = QListWidget(); self.list.setMaximumWidth(240)
        add, rm = QPushButton("＋ Add"), QPushButton("− Remove")
        add.clicked.connect(self.add); rm.clicked.connect(self.remove)
        left = QVBoxLayout(); left.addWidget(self.list); row = QHBoxLayout(); row.addWidget(add); row.addWidget(rm); left.addLayout(row)

        self.name = QLineEdit()
        self.fan = QComboBox()
        for f in self.dev["fans"]: self.fan.addItem(f["label"], f["id"])
        self.temps = QListWidget(); self.temps.setMaximumHeight(110)
        for t in self.dev["temps"]:
            it = QListWidgetItem(t["label"]); it.setData(Qt.ItemDataRole.UserRole, t["id"]); it.setFlags(it.flags() | Qt.ItemFlag.ItemIsUserCheckable); it.setCheckState(Qt.CheckState.Unchecked)
            self.temps.addItem(it)
        self.mn, self.mx = spin(0, 100, 1, " %"), spin(0, 100, 1, " %")
        self.hy, self.up, self.dn, self.cr = spin(0, 20, 0.5, " °C", 1), spin(0.5, 100, 1, " %/s", 1), spin(0.5, 100, 1, " %/s", 1), spin(50, 110, 1, " °C")
        self.curve = Curve()
        form = QFormLayout()
        form.addRow("Name", self.name); form.addRow("Fan", self.fan); form.addRow("Temp sources (max)", self.temps)
        form.addRow("Min / Max speed", self._h(self.mn, self.mx)); form.addRow("Hysteresis", self.hy)
        form.addRow("Ramp up / down", self._h(self.up, self.dn)); form.addRow("Critical temp → 100%", self.cr)
        self.live = QLabel("—"); self.state = QLabel("")
        hint = QLabel("Curve: drag points · double-click = add point · right-click = remove")
        hint.setStyleSheet("color: gray")
        self.apply_btn = QPushButton("Apply"); self.apply_btn.clicked.connect(self.apply)
        right = QVBoxLayout(); right.addLayout(form); right.addWidget(self.curve, 1); right.addWidget(hint); right.addWidget(self.live)
        bot = QHBoxLayout(); bot.addWidget(self.state, 1); bot.addWidget(self.apply_btn); right.addLayout(bot)
        root = QHBoxLayout(); root.addLayout(left); root.addLayout(right, 1)
        w = QWidget(); w.setLayout(root); self.setCentralWidget(w)

        for s in (self.name.textChanged,): s.connect(self.sync)
        self.fan.currentIndexChanged.connect(self.sync); self.temps.itemChanged.connect(self.sync)
        for sp in (self.mn, self.mx, self.hy, self.up, self.dn, self.cr): sp.valueChanged.connect(self.sync)
        self.curve.changed.connect(self.sync)
        self.list.currentRowChanged.connect(self.select); self.list.itemChanged.connect(self.sync_enabled)
        for c in self.cfg["controls"]: self._item(c)
        self.loading = False
        if self.list.count(): self.list.setCurrentRow(0)
        else: self.select(-1)
        t = QTimer(self); t.timeout.connect(self.refresh); t.start(1000); self.refresh()

    @staticmethod
    def _h(*ws):
        w = QWidget(); l = QHBoxLayout(w); l.setContentsMargins(0, 0, 0, 0)
        for x in ws: l.addWidget(x)
        return w

    def _item(self, c):
        it = QListWidgetItem(c["name"] or "Fan"); it.setFlags(it.flags() | Qt.ItemFlag.ItemIsUserCheckable)
        it.setCheckState(Qt.CheckState.Checked if c.get("enabled", True) else Qt.CheckState.Unchecked)
        self.list.addItem(it)

    def add(self):
        if not self.dev["fans"] or not self.dev["temps"]:
            QMessageBox.warning(self, "No devices", "No controllable fans/sensors found.\nCheck kernel drivers (nct6775/it87, amdgpu) or install python-nvidia-ml-py for NVIDIA.")
            return
        c = {"id": uuid.uuid4().hex[:8], "name": f"Fan {len(self.cfg['controls']) + 1}", "fan": self.dev["fans"][0]["id"],
             "temps": [self.dev["temps"][0]["id"]], "curve": [list(p) for p in DEFAULT_CURVE], "min_pct": 20, "max_pct": 100,
             "hyst": 3.0, "up_rate": 25.0, "down_rate": 5.0, "critical": 90.0, "enabled": True}
        self.cfg["controls"].append(c); self.loading = True; self._item(c); self.loading = False
        self.list.setCurrentRow(self.list.count() - 1)

    def remove(self):
        i = self.list.currentRow()
        if i >= 0:
            self.loading = True; del self.cfg["controls"][i]; self.list.takeItem(i); self.loading = False
            self.select(self.list.currentRow())

    def select(self, i):
        self.cur = self.cfg["controls"][i] if 0 <= i < len(self.cfg["controls"]) else None
        self.loading = True
        en = self.cur is not None
        for w in (self.name, self.fan, self.temps, self.mn, self.mx, self.hy, self.up, self.dn, self.cr, self.curve): w.setEnabled(en)
        if en:
            c = self.cur
            self.name.setText(c["name"]); self.fan.setCurrentIndex(max(0, self.fan.findData(c["fan"])))
            for k in range(self.temps.count()):
                it = self.temps.item(k)
                it.setCheckState(Qt.CheckState.Checked if it.data(Qt.ItemDataRole.UserRole) in c["temps"] else Qt.CheckState.Unchecked)
            self.mn.setValue(c["min_pct"]); self.mx.setValue(c["max_pct"]); self.hy.setValue(c["hyst"])
            self.up.setValue(c["up_rate"]); self.dn.setValue(c["down_rate"]); self.cr.setValue(c["critical"])
            self.curve.set_points(c["curve"])
        self.loading = False

    def sync(self, *_):
        if self.loading or not self.cur: return
        c = self.cur
        c["name"] = self.name.text(); c["fan"] = self.fan.currentData()
        c["temps"] = [self.temps.item(k).data(Qt.ItemDataRole.UserRole) for k in range(self.temps.count()) if self.temps.item(k).checkState() == Qt.CheckState.Checked]
        c["min_pct"], c["max_pct"], c["hyst"] = self.mn.value(), self.mx.value(), self.hy.value()
        c["up_rate"], c["down_rate"], c["critical"] = self.up.value(), self.dn.value(), self.cr.value()
        c["curve"] = sorted([list(p) for p in self.curve.pts])
        self.loading = True; self.list.currentItem().setText(c["name"] or "Fan"); self.loading = False

    def sync_enabled(self, it):
        if self.loading: return
        self.cfg["controls"][self.list.row(it)]["enabled"] = it.checkState() == Qt.CheckState.Checked

    def refresh(self):
        c, txt = self.cur, "—"
        self.curve.live = None
        if c:
            try:
                ts = [v for v in (core.read_temp(t) for t in c["temps"]) if v is not None]
                if ts: self.curve.live = max(ts)
                r = core.make_fan(c["fan"]).read()
                txt = f"Temp: {max(ts):.0f} °C" if ts else "Temp: n/a"
                txt += f"   |   Fan: {r['pct']}%" + (f", {r['rpm']} RPM" if r["rpm"] is not None else "")
            except Exception as e:
                txt = f"read error: {e}"
        self.live.setText(txt); self.curve.update()
        try:
            with open(core.STATUS) as f: st = json.load(f)
            ok = time.time() - st["ts"] < 5
        except Exception:
            ok = False
        self.state.setText("Daemon: running ✓" if ok else "Daemon: not running — Apply will offer to enable it")

    def apply(self):
        self.sync()
        enable = subprocess.run(["systemctl", "is-active", "--quiet", "archfanctl.service"]).returncode != 0
        if enable and QMessageBox.question(self, "Start service", "Service archfanctl is not running.\nEnable and start it at boot too?") != QMessageBox.StandardButton.Yes:
            enable = False
        cmd = ["pkexec", "/usr/bin/archfanctl-apply"] + (["--enable"] if enable else [])
        r = subprocess.run(cmd, input=json.dumps(self.cfg), text=True, capture_output=True)
        if r.returncode: QMessageBox.critical(self, "Apply failed", r.stderr or "authentication cancelled")
        else: self.state.setText("Applied ✓")


app = QApplication(sys.argv)
w = Win(); w.show()
sys.exit(app.exec())
